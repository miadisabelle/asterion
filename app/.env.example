# Asterion environment
# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# --- Neon Postgres (required) -------------------------------------------------
# The only variable the app code reads directly. Everything else is convenience.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Provided by the Neon integration; kept for tooling parity.
DATABASE_URL_UNPOOLED=
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGPASSWORD=
PGDATABASE=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
NEON_PROJECT_ID=

# --- Upstash Redis (required) -------------------------------------------------
# Redis.fromEnv() accepts either the KV_REST_API_* or UPSTASH_REDIS_REST_* pair.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
REDIS_URL=
