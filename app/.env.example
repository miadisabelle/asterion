# Asterion environment
# Copy to .env.local and fill in. .env* is gitignored — never commit real values.

# --- Neon Postgres (required) -------------------------------------------------
# The only variable the app code reads directly. Everything else is convenience.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Provided by the Neon integration; kept for tooling parity.
DATABASE_URL_UNPOOLED=
PGHOST=
PGHOST_UNPOOLED=
PGUSER=
PGPASSWORD=
PGDATABASE=
POSTGRES_URL=
POSTGRES_URL_NON_POOLING=
POSTGRES_PRISMA_URL=
POSTGRES_URL_NO_SSL=
POSTGRES_HOST=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=
NEON_PROJECT_ID=
NEON_AUTH_BASE_URL=
VITE_NEON_AUTH_URL=

# --- Upstash Redis (required) -------------------------------------------------
# Redis.fromEnv() accepts either the KV_REST_API_* or UPSTASH_REDIS_REST_* pair.
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
KV_URL=
REDIS_URL=

# --- Vercel Blob ---------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Injected by `vercel env pull`, not authored -------------------------------
# VERCEL_OIDC_TOKEN — short-lived, rotates on every pull. Do not hand-edit.
